# ─────────────────────────────────────────────────────────────────────────
# FOR CONTRIBUTORS TO THIS REPO — you do NOT need any of this to use an SDK.
#
# To call the API you only need an API key, which you pass to the client or
# put in INDOX_API_KEY. Every client already defaults to https://indox.org.
#
#     export INDOX_API_KEY=ak_your_key_here
#
# The values below configure the codegen pipeline and the gates:
#     make openapi    rebuild spec/openapi-public.json from a running API
#     make gen-all    regenerate all 8 clients from that spec
#     make ci         drift + package layout + the multi-language suite
#
# Copy to .env and adjust. .env is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────

# Where the TOOLING reads the live schema, and where the test harness probes.
# Point it at whichever API instance you develop against.
# (An end user may also set this to reach a self-hosted instance instead of
#  the default — that is its only meaning outside this repo.)
INDOX_BASE_URL=https://indox.org

# What the generated clients SHIP with as their default base URL. Changing it
# changes every regenerated client, so it should stay the public production API.
INDOX_PUBLIC_BASE_URL=https://indox.org

# Codegen only — the GitHub org used for module paths (e.g.
# github.com/nematiai/indox-go), the version stamped into every package
# manifest, and the generator image.
INDOX_GIT_USER=nematiai
INDOX_SDK_VERSION=0.4.0
INDOX_OPENAPI_GENERATOR_IMAGE=openapitools/openapi-generator-cli:v7.11.0

# Test harness only — a JSON file holding an API key for the live probes.
# Without it the suite SKIPs rather than failing. Keep it outside the repo, 0600.
INDOX_CREDS_FILE=/path/to/creds.json

# Publishing — PyPI upload token, scoped to the indox-client project.
# Put it in .env (git-ignored, chmod 600) or export it; the environment wins.
#     PYPI_TOKEN=pypi-…
#     make publish     upload the current version
#     make release     +1 the version, commit, publish, tag and push
#     TESTPYPI=1 make publish   rehearse against test.pypi.org
PYPI_TOKEN=pypi-replace-me
