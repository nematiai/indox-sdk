# Secrets — never commit
.env
.env.*
*.pem
*.key
*_creds.json

# Python build / cache
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg
build/
dist/
.venv/
.venv-verify/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
coverage/
htmlcov/
.coverage
coverage.xml

# Per-language build / vendor output
node_modules/
target/
vendor/
bin/
obj/
.gradle/
*.class
out/
*.gem

# MkDocs build output
site/

# OS / editor / local agent
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
*.log

