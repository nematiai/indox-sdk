# Secrets — never commit
.env
.env.*
*.pem
*.key
*_creds.json

# Colab convert outputs (keep empty dirs via .keep)
colab/**/output/**
!colab/**/output/.keep
colab/**/indox_*_results.json
colab/convert_coverage_results.json
# Local scratch notebooks under colab/
colab/**/verify_*.ipynb
colab/**/.ipynb_checkpoints/

# Python build / cache
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg
build/
dist/
.venv/
.venv-verify/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
coverage/
htmlcov/
.coverage
coverage.xml

# Per-language build / vendor output
node_modules/
target/
vendor/
bin/
obj/
.gradle/
*.class
out/
*.gem

# MkDocs build output
site/

# OS / editor / local agent
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
*.log

# Regenerated by `make gen-all` from spec/openapi-public.json
languages/*/generated/

# copied from the canonical root LICENSE at build time
languages/python/LICENSE

# Internal spec — stays on disk for the build, never published
spec/openapi-drf.json
spec/ALLOWLIST.md
spec/PLAN.md
spec/README.md
